{
  "name": "react-highlight-popover",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "typecheck": "turbo typecheck",
    "test": "turbo build --filter=@omsimos/react-highlight-popover && bun test",
    "version-packages": "changeset version && bun install --lockfile-only",
    "format": "bun fmt",
    "prepare": "git config core.hooksPath .githooks || true",
    "clean": "rm -rf node_modules docs/node_modules lib/node_modules tests/node_modules && bun i"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "tsdown": "^0.23.4",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "docs",
    "lib",
    "tests"
  ]
}
